# ════════════════════════════════════════════════════════════
#  EcY_S3CB0T — Ortam Değişkenleri Şablonu
#  Kopyalayın:  cp .env.example .env
#  Ardından .env dosyasını doldurun.
# ════════════════════════════════════════════════════════════

# ── Web UI ───────────────────────────────────────────────────
UI_PORT=3000
SESSION_SECRET=                   # openssl rand -hex 32
FORCE_SECURE_COOKIES=false        # HTTPS arkasında true yapın

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_TOKEN=                   # BotFather'dan alınan token
TELEGRAM_CHAT_ID=                 # Hedef chat/grup ID

# ── Wazuh SIEM ───────────────────────────────────────────────
WAZUH_HOST=https://wazuh-server:55000
WAZUH_USER=wazuh
WAZUH_PASS=
WAZUH_ALERT_LEVEL=7               # Minimum alert seviyesi (1-15)
WAZUH_VERIFY_SSL=0                # 1 = SSL doğrula, 0 = atla

# ── Observium ────────────────────────────────────────────────
OBSERVIUM_HOST=http://observium-server
OBSERVIUM_USER=admin
OBSERVIUM_PASS=

# ── Graylog (opsiyonel) ──────────────────────────────────────
GRAYLOG_HOST=                     # http://graylog:9000  (boş = devre dışı)
GRAYLOG_USER=admin
GRAYLOG_PASS=
GRAYLOG_RANGE_SECONDS=3600        # Sorgu penceresi (saniye)
GRAYLOG_VERIFY_SSL=0

# ── Fortinet FortiGate (opsiyonel) ───────────────────────────
FORTINET_HOST=                    # https://10.0.0.1  (boş = devre dışı)
FORTINET_AUTH=token               # token | session
FORTINET_API_TOKEN=               # API token (önerilen)
FORTINET_USER=admin               # session auth için
FORTINET_PASS=
FORTINET_VDOM=root
FORTINET_VERIFY_SSL=0
FORTINET_TIMEOUT=15

# ── Prometheus / Alertmanager (opsiyonel) ────────────────────
PROMETHEUS_HOST=                  # http://prometheus:9090  (boş = devre dışı)
ALERTMANAGER_HOST=                # http://alertmanager:9093 (boş = devre dışı)
PROMETHEUS_USER=                  # Basic auth (opsiyonel)
PROMETHEUS_PASS=
PROMETHEUS_VERIFY_SSL=0
PROMETHEUS_TIMEOUT=15

# ── Zabbix (opsiyonel) ───────────────────────────────────────
ZABBIX_HOST=                      # http://zabbix-web  (boş = devre dışı)
ZABBIX_USER=Admin
ZABBIX_PASS=
ZABBIX_API_TOKEN=                 # Token (Zabbix 5.4+, önerilen)
ZABBIX_VERIFY_SSL=0
ZABBIX_TIMEOUT=15

# ── Generic Webhook ──────────────────────────────────────────
WEBHOOK_PORT=8080                 # Dış port — POST http://sunucu:8080/webhook
WEBHOOK_SECRET=                   # Bearer token ile koruma (boş = auth yok)
WEBHOOK_MAX_STORE=200             # Bellekte tutulacak max webhook sayısı

# ── LLM ─────────────────────────────────────────────────────
LLM_PROVIDER=ollama               # ollama | claude | openai

# Ollama (yerel) ─────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b           # gemma4:e4b, llama3.2:3b, vb.

# Claude API (Anthropic) ─────────────────────────────────────
CLAUDE_API_KEY=                   # sk-ant-api03-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI-compatible API ──────────────────────────────────────
OPENAI_API_KEY=                   # sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── ElasticSearch / OpenSearch (opsiyonel) ──────────────────
ELASTIC_HOST=                     # http://elastic:9200  (boş = devre dışı)
ELASTIC_USER=elastic
ELASTIC_PASS=
ELASTIC_INDEX=*                   # Sorgulanacak index pattern
ELASTIC_VERIFY_SSL=0
ELASTIC_TIMEOUT=15

# ── SMTP E-posta Bildirimi (opsiyonel) ───────────────────────
SMTP_HOST=                        # mail.sirket.com  (boş = devre dışı)
SMTP_PORT=587                     # 587 (STARTTLS) | 465 (SSL) | 25
SMTP_USER=                        # bot@sirket.com
SMTP_PASS=
SMTP_FROM=                        # Gönderici adres (boş = SMTP_USER)
SMTP_TO=                          # Alıcılar, virgülle ayırın: a@x.com,b@x.com
SMTP_TLS=1                        # 1 = STARTTLS, 0 = düz bağlantı
SMTP_ON_CRITICAL_ONLY=1           # 1 = sadece kritik raporda gönder

# ── Slack Bildirimi (opsiyonel) ──────────────────────────────
SLACK_WEBHOOK_URL=                # https://hooks.slack.com/...  (boş = devre dışı)
SLACK_CHANNEL=                    # #kanal override (opsiyonel)
SLACK_ON_CRITICAL_ONLY=1

# ── Microsoft Teams Bildirimi (opsiyonel) ────────────────────
TEAMS_WEBHOOK_URL=                # https://xxx.webhook.office.com/...  (boş = devre dışı)
TEAMS_ON_CRITICAL_ONLY=1

# ── Rapor zamanlayıcı ────────────────────────────────────────
CHECK_INTERVAL_MINUTES=30
